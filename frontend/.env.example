# Where the Next.js *server* reaches the backend. Not prefixed with NEXT_PUBLIC_,
# so it never reaches the browser bundle — inside Docker it is a service name the
# browser could not resolve anyway.
#
# With this (the default), the browser only ever talks to this app's own origin:
# `/api/*` is rewritten to the backend, the session cookie is first-party, there is
# no CORS preflight on every call, and no third-party cookie policy can drop it.
BACKEND_URL=http://localhost:8000

# Optional escape hatch: point the browser straight at the backend instead, which
# disables the rewrite above. The two hosts must then share a registrable domain
# (app.example.com and api.example.com) for a SameSite=Lax session cookie to
# travel between them, and the backend's CORS_ORIGINS must name this app.
# NEXT_PUBLIC_API_URL=http://localhost:8000
