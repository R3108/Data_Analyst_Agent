# ── LLM ──────────────────────────────────────────────────────────────────────
# Required. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model used for planning, code generation and insight writing.
OPENAI_MODEL=gpt-5.6-luna
# Optional: low | medium | high | xhigh | max.
# Lower effort answers faster and cheaper; higher effort reasons more deeply.
ANALYST_EFFORT=low
# Upper bound for each planning, coding or reporting response.
LLM_MAX_TOKENS=8000
# Calendar-month spend guardrail. Set to 0 to disable.
AI_MONTHLY_BUDGET_USD=5

# ── Agent ────────────────────────────────────────────────────────────────────
# How many times the agent may rewrite failing code before giving up.
MAX_REPAIR_ATTEMPTS=2
# Previous turns (question + answer summaries) sent as context for follow-ups.
HISTORY_TURNS=6

# ── Analysis memory ──────────────────────────────────────────────────────────
# Prior answers to a similar question are found deterministically (TF-IDF, no
# embedding model) and given to the planner as continuity context — and to you
# as a "you asked this before" notice, before any model work starts.
RECALL_ENABLED=true
RECALL_LIMIT=3

# ── Investigations ───────────────────────────────────────────────────────────
# A deep-research run executes this many analyses plus one scoping and one
# synthesis call, so it costs roughly this many ordinary questions plus two.
INVESTIGATION_MAX_STEPS=4

# ── Scheduled briefings ──────────────────────────────────────────────────────
# Sweep interval for saved questions that re-ask themselves, in minutes. 0
# disables the scheduler; briefings can always be run on demand. Unlike a
# monitor, every briefing run costs model tokens.
BRIEFING_INTERVAL_MINUTES=0

# ── SQL sources ──────────────────────────────────────────────────────────────
# Background refresh sweep for connected databases, in minutes. 0 disables the
# scheduler; a source can always be synced on demand. Each source also has its
# own refresh interval, set in the UI.
SOURCE_SYNC_INTERVAL_MINUTES=0
# Dialects ship with SQLAlchemy; drivers are optional extras installed only if
# you use them: pip install 'psycopg[binary]' pymysql pyodbc duckdb-engine

# ── Sandbox ──────────────────────────────────────────────────────────────────
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=2048

# ── Monitors ─────────────────────────────────────────────────────────────────
# Background sweep interval for metric monitors, in minutes. 0 disables the
# scheduler; monitors can still be run on demand and always re-run when a new
# version of their dataset is uploaded. Re-checks cost no model tokens.
MONITOR_INTERVAL_MINUTES=0
# How many observations to keep per monitor.
MONITOR_HISTORY_LIMIT=60

# ── Alerts ───────────────────────────────────────────────────────────────────
# Delivery of monitor breaches, recoveries and failed data contracts. Channels
# themselves (Slack / webhook / email) are added in the UI under Monitors.
ALERTS_ENABLED=true
ALERT_TIMEOUT_S=10
# Scheduled monitor briefing, in hours. 0 disables it; state changes still alert.
ALERT_DIGEST_HOURS=0
# Used for the "open in Numera" link inside an alert.
PUBLIC_BASE_URL=http://localhost:3000

# Email alerts stay unavailable until SMTP_HOST is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=numera@example.com
# SMTP_STARTTLS=true

# ── Storage & limits ─────────────────────────────────────────────────────────
# DATA_DIR=./backend/data
MAX_UPLOAD_MB=50
MAX_ROWS=2000000

# ── Access control ───────────────────────────────────────────────────────────
# Empty means the workspace is open — the right default for a local tool. Set a
# comma-separated list of "token:Display Name" pairs to require a bearer token on
# every API call and to attribute comments and activity to the matching person.
# Public share links keep working either way: they carry their own token and are
# read-only by construction.
# WORKSPACE_TOKENS=s3cret-ada:Ada Lovelace, s3cret-grace:Grace Hopper
WORKSPACE_TOKENS=

# ── HTTP ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
