# ── LLM ──────────────────────────────────────────────────────────────────────
# Required. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model used for planning, code generation and insight writing.
OPENAI_MODEL=gpt-5.6-luna
# Optional: low | medium | high | xhigh | max.
# Lower effort answers faster and cheaper; higher effort reasons more deeply.
ANALYST_EFFORT=low
# Upper bound for each planning, coding or reporting response.
LLM_MAX_TOKENS=8000
# Calendar-month spend guardrail. Set to 0 to disable.
AI_MONTHLY_BUDGET_USD=5

# ── Agent ────────────────────────────────────────────────────────────────────
# How many times the agent may rewrite failing code before giving up.
MAX_REPAIR_ATTEMPTS=2
# Previous turns (question + answer summaries) sent as context for follow-ups.
HISTORY_TURNS=6

# ── Analysis memory ──────────────────────────────────────────────────────────
# Prior answers to a similar question are found deterministically (TF-IDF, no
# embedding model) and given to the planner as continuity context — and to you
# as a "you asked this before" notice, before any model work starts.
RECALL_ENABLED=true
RECALL_LIMIT=3

# ── Investigations ───────────────────────────────────────────────────────────
# A deep-research run executes this many analyses plus one scoping and one
# synthesis call, so it costs roughly this many ordinary questions plus two.
INVESTIGATION_MAX_STEPS=4

# ── Scheduled briefings ──────────────────────────────────────────────────────
# Sweep interval for saved questions that re-ask themselves, in minutes. 0
# disables the scheduler; briefings can always be run on demand. Unlike a
# monitor, every briefing run costs model tokens.
BRIEFING_INTERVAL_MINUTES=0

# ── SQL sources ──────────────────────────────────────────────────────────────
# Background refresh sweep for connected databases, in minutes. 0 disables the
# scheduler; a source can always be synced on demand. Each source also has its
# own refresh interval, set in the UI.
SOURCE_SYNC_INTERVAL_MINUTES=0
# Dialects ship with SQLAlchemy; drivers are optional extras installed only if
# you use them: pip install 'psycopg[binary]' pymysql pyodbc duckdb-engine

# ── Sandbox ──────────────────────────────────────────────────────────────────
SANDBOX_TIMEOUT_S=60
SANDBOX_MEMORY_MB=2048

# ── Monitors ─────────────────────────────────────────────────────────────────
# Background sweep interval for metric monitors, in minutes. 0 disables the
# scheduler; monitors can still be run on demand and always re-run when a new
# version of their dataset is uploaded. Re-checks cost no model tokens.
MONITOR_INTERVAL_MINUTES=0
# How many observations to keep per monitor.
MONITOR_HISTORY_LIMIT=60
# When a monitor breaches, run the deterministic driver drill-down on its measure
# and attach the result to the run, the digest and the alert — so the message names
# a cause, not just a number. One extra pass over the cleaned table, zero tokens.
# Set to false if a very large table makes the sweep too slow.
MONITOR_ROOT_CAUSE=true

# ── Privacy guard ────────────────────────────────────────────────────────────
# Detect personal data (emails, card numbers, national ids, phones, names, IPs)
# when a file lands. Detected example values are withheld from every prompt
# whatever this is set to — this only controls whether the detector runs at all.
# Redaction itself (mask / hash / drop) is always an explicit choice in the UI.
PRIVACY_SCAN_ENABLED=true

# ── Alerts ───────────────────────────────────────────────────────────────────
# Delivery of monitor breaches, recoveries and failed data contracts. Channels
# themselves (Slack / webhook / email) are added in the UI under Monitors.
ALERTS_ENABLED=true
ALERT_TIMEOUT_S=10
# Scheduled monitor briefing, in hours. 0 disables it; state changes still alert.
ALERT_DIGEST_HOURS=0
# Used for the "open in Numera" link inside an alert.
PUBLIC_BASE_URL=http://localhost:3000

# Email alerts stay unavailable until SMTP_HOST is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=numera@example.com
# SMTP_STARTTLS=true

# ── Storage & limits ─────────────────────────────────────────────────────────
# DATA_DIR=./backend/data
MAX_UPLOAD_MB=50
MAX_ROWS=2000000

# ── Accounts & sessions ──────────────────────────────────────────────────────
# Numera is multi-user. Every account gets its own SQLite database and its own
# directory of cleaned tables under DATA_DIR/users/<id>/ — isolation is physical,
# not a WHERE clause, so no query can reach another account's rows. The first
# account to register becomes the administrator.
#
# REQUIRED in production. Keys session and password-reset tokens at rest, so a
# stolen copy of auth.db cannot be replayed against a running server. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs every account out, which is a deliberate "revoke everything".
AUTH_SECRET=

# Set both to create the first administrator automatically on an empty database —
# useful for an unattended deploy. Leave blank to let the first person who
# registers become the administrator instead. Either way, an existing single-user
# numera.db is adopted into that first account on startup.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Open sign-up. Set to false for an invite-only deployment; an admin then creates
# accounts from the dashboard. The very first account is always allowed, or a
# closed deployment would be unreachable.
REGISTRATION_ENABLED=true
# Restrict sign-up to one or more email domains. Empty means any address.
# REGISTRATION_ALLOWED_DOMAINS=acme.com,acme.co.uk
# Seat cap. 0 means unlimited.
MAX_USERS=0

# ── Sign in with Google ──────────────────────────────────────────────────────
# Adds "Continue with Google" to the sign-in and sign-up screens. Off until both
# values are set. In Google Cloud Console → APIs & Services → Credentials, create
# an OAuth client ID of type "Web application" and add this authorised redirect
# URI, exactly:
#   <PUBLIC_BASE_URL>/api/auth/google/callback   (e.g. http://localhost:3000/api/auth/google/callback)
# The secret stays on the server: the browser never sees it or any Google token.
# Sign-up rules above (REGISTRATION_ENABLED, allowed domains, MAX_USERS) apply to
# Google sign-ups too.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Only if the callback is served somewhere other than PUBLIC_BASE_URL.
# GOOGLE_REDIRECT_URI=

# Session lifetime. Idle expires an unused session; absolute is a hard ceiling that
# activity never extends, so a stolen cookie dies on its own.
SESSION_IDLE_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# Cookie flags. Leave COOKIE_SECURE unset for "Secure in production, not in
# development" — the correct default. Over HTTPS the cookies also take the
# __Host- prefix, which stops a sibling subdomain overwriting a session.
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Only when the app and the API are on different subdomains of one site.
# COOKIE_DOMAIN=.example.com

# ── Abuse limits ─────────────────────────────────────────────────────────────
# Sign-in attempts per IP per window, then per-account lockout after this many
# consecutive failures. A locked account reports the same message as a wrong
# password, so an attacker cannot tell that they succeeded in locking one.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
LOCKOUT_THRESHOLD=8
LOCKOUT_MINUTES=15
REGISTER_MAX_PER_HOUR=5
RESET_MAX_PER_HOUR=5
RESET_TOKEN_TTL_MINUTES=30

# Password-reset links are emailed through the SMTP settings above. Without an
# SMTP host they are written to the server log instead. On a development server
# only, this returns the link in the API response so you can click it; it is
# ignored in production, where it would be an account-takeover vector.
EXPOSE_RESET_LINK=false

# ── HTTP ─────────────────────────────────────────────────────────────────────
# The origins the browser app is served from. This is a trust list, not a
# convenience: it is checked on every state-changing request as well as by CORS.
# With the default same-origin setup (Next rewrites /api to this backend) it is
# the frontend's own address.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Turn on only behind a reverse proxy that sets the header itself. Exposed
# directly, X-Forwarded-For is attacker-controlled.
TRUST_FORWARDED_FOR=false
LOG_LEVEL=INFO
